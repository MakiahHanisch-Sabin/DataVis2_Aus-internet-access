{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "The technology behind Ready (non-active) premises",
  "width": "container",
  "height": 360,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Inter, Arial, sans-serif",
    "title": {
      "font": "Inter, Arial, sans-serif",
      "fontSize": 16,
      "fontWeight": 700,
      "anchor": "start",
      "color": "#12212f",
      "offset": 12
    },
    "axis": {
      "labelFont": "Inter, Arial, sans-serif",
      "titleFont": "Inter, Arial, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#435466",
      "titleColor": "#435466",
      "gridColor": "#e8eff5",
      "domainColor": "#cbd9e5",
      "tickColor": "#cbd9e5"
    },
    "legend": {
      "labelFont": "Inter, Arial, sans-serif",
      "titleFont": "Inter, Arial, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#435466",
      "titleColor": "#12212f",
      "orient": "right"
    },
    "range": {
      "category": [
        "#2F6F9F",
        "#FF9F1C",
        "#2CA58D",
        "#8E6CBB",
        "#E45756",
        "#54A24B",
        "#B279A2",
        "#F58518"
      ]
    },
    "bar": {
      "cornerRadiusEnd": 4
    },
    "line": {
      "strokeWidth": 3
    },
    "circle": {
      "opacity": 0.85
    }
  },
  "data": {
    "url": "./data/nbn_technology_ready_long.csv"
  },
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "state",
      "type": "nominal",
      "title": "State"
    },
    "y": {
      "field": "Ready",
      "type": "quantitative",
      "stack": "normalize",
      "axis": {
        "format": "%"
      },
      "title": "Share of ready premises"
    },
    "color": {
      "field": "Technology",
      "type": "nominal",
      "title": "Technology",
      "scale": {
        "range": [
          "#2F6F9F",
          "#FF9F1C",
          "#8E6CBB"
        ]
      }
    },
    "tooltip": [
      {
        "field": "state",
        "title": "State"
      },
      {
        "field": "Technology",
        "title": "Technology"
      },
      {
        "field": "Ready",
        "type": "quantitative",
        "format": ",",
        "title": "Ready premises"
      }
    ]
  }
}