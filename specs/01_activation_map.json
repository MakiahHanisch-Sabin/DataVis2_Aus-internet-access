{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Where the NBN is activated",
  "width": "container",
  "height": 430,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "data": {
    "url": "https://raw.githubusercontent.com/anthwri/GeoJson-Data/master/australian-states.json",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "./data/nbn_state_jan2025.csv"
        },
        "key": "state_name",
        "fields": [
          "state",
          "activation_rate",
          "total_ready",
          "total_activated"
        ]
      }
    }
  ],
  "projection": {
  "type": "mercator",
  "center": [134, -27],
  "scale": 560
},
  "mark": {
    "type": "geoshape",
    "stroke": "#ffffff",
    "strokeWidth": 1.4
  },
  "encoding": {
    "color": {
      "field": "activation_rate",
      "type": "quantitative",
      "title": "Activated (%)",
      "scale": {
        "scheme": "blues",
        "domain": [55, 75]
      },
      "legend": {
        "format": ".0f"
      }
    },
    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "type": "nominal",
        "title": "State / Territory"
      },
      {
        "field": "state",
        "type": "nominal",
        "title": "Code"
      },
      {
        "field": "activation_rate",
        "type": "quantitative",
        "title": "Activated (%)",
        "format": ".1f"
      },
      {
        "field": "total_ready",
        "type": "quantitative",
        "title": "Ready to connect",
        "format": ","
      },
      {
        "field": "total_activated",
        "type": "quantitative",
        "title": "Activated",
        "format": ","
      }
    ]
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Inter, Arial, sans-serif",
    "title": {
      "font": "Inter, Arial, sans-serif",
      "fontSize": 16,
      "fontWeight": 700,
      "anchor": "start",
      "color": "#12212f",
      "offset": 12
    },
    "axis": {
      "labelFont": "Inter, Arial, sans-serif",
      "titleFont": "Inter, Arial, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#435466",
      "titleColor": "#435466",
      "gridColor": "#e8eff5",
      "domainColor": "#cbd9e5",
      "tickColor": "#cbd9e5"
    },
    "legend": {
      "labelFont": "Inter, Arial, sans-serif",
      "titleFont": "Inter, Arial, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#435466",
      "titleColor": "#12212f",
      "orient": "right"
    }
  }
}