{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "How close 2022 measured speeds were to advertised plan speeds",
  "width": "container",
  "height": 360,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Inter, Arial, sans-serif",
    "title": {
      "font": "Inter, Arial, sans-serif",
      "fontSize": 16,
      "fontWeight": 700,
      "anchor": "start",
      "color": "#12212f",
      "offset": 12
    },
    "axis": {
      "labelFont": "Inter, Arial, sans-serif",
      "titleFont": "Inter, Arial, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#435466",
      "titleColor": "#435466",
      "gridColor": "#e8eff5",
      "domainColor": "#cbd9e5",
      "tickColor": "#cbd9e5"
    },
    "legend": {
      "labelFont": "Inter, Arial, sans-serif",
      "titleFont": "Inter, Arial, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#435466",
      "titleColor": "#12212f",
      "orient": "right"
    },
    "range": {
      "category": [
        "#2F6F9F",
        "#FF9F1C",
        "#2CA58D",
        "#8E6CBB",
        "#E45756",
        "#54A24B",
        "#B279A2",
        "#F58518"
      ]
    },
    "bar": {
      "cornerRadiusEnd": 4
    },
    "line": {
      "strokeWidth": 3
    },
    "circle": {
      "opacity": 0.85
    }
  },
  "data": {
    "url": "./data/speed_by_plan.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#e3edf5",
        "cornerRadiusEnd": 4
      },
      "encoding": {
        "y": {
          "field": "Plan",
          "type": "nominal",
          "sort": [
            "NBN 750",
            "NBN 500",
            "NBN 100",
            "NBN 50",
            "NBN 25"
          ],
          "title": "Plan"
        },
        "x": {
          "field": "Advertised",
          "type": "quantitative",
          "title": "Download speed, Mbps",
          "scale": {
            "domainMin": 0
          }
        },
        "tooltip": [
          {
            "field": "Plan"
          },
          {
            "field": "Advertised",
            "type": "quantitative",
            "title": "Advertised Mbps"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "bar",
        "height": 16,
        "cornerRadiusEnd": 4
      },
      "encoding": {
        "y": {
          "field": "Plan",
          "type": "nominal",
          "sort": [
            "NBN 750",
            "NBN 500",
            "NBN 100",
            "NBN 50",
            "NBN 25"
          ],
          "title": "Plan"
        },
        "x": {
          "field": "2022",
          "type": "quantitative",
          "title": "Download speed, Mbps",
          "scale": {
            "domainMin": 0
          }
        },
        "color": {
          "field": "Plan",
          "type": "nominal",
          "title": "Plan",
          "scale": {
            "range": [
              "#2F6F9F",
              "#FF9F1C",
              "#2CA58D",
              "#8E6CBB",
              "#E45756"
            ]
          }
        },
        "tooltip": [
          {
            "field": "Plan"
          },
          {
            "field": "2022",
            "type": "quantitative",
            "title": "Measured 2022 Mbps"
          },
          {
            "field": "Advertised",
            "type": "quantitative",
            "title": "Advertised Mbps"
          }
        ]
      }
    }
  ]
}