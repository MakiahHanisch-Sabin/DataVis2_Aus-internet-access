{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Australia\u2019s internet downloads rose rapidly in 2017\u20132018",
  "width": "container",
  "height": 360,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Inter, Arial, sans-serif",
    "title": {
      "font": "Inter, Arial, sans-serif",
      "fontSize": 16,
      "fontWeight": 700,
      "anchor": "start",
      "color": "#12212f",
      "offset": 12
    },
    "axis": {
      "labelFont": "Inter, Arial, sans-serif",
      "titleFont": "Inter, Arial, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#435466",
      "titleColor": "#435466",
      "gridColor": "#e8eff5",
      "domainColor": "#cbd9e5",
      "tickColor": "#cbd9e5"
    },
    "legend": {
      "labelFont": "Inter, Arial, sans-serif",
      "titleFont": "Inter, Arial, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#435466",
      "titleColor": "#12212f",
      "orient": "right"
    },
    "range": {
      "category": [
        "#2F6F9F",
        "#FF9F1C",
        "#2CA58D",
        "#8E6CBB",
        "#E45756",
        "#54A24B",
        "#B279A2",
        "#F58518"
      ]
    },
    "bar": {
      "cornerRadiusEnd": 4
    },
    "line": {
      "strokeWidth": 3
    },
    "circle": {
      "opacity": 0.85
    }
  },
  "data": {
    "url": "./data/download_tb_long.csv"
  },
  "transform": [
    {
      "filter": "datum.Connection == 'Total'"
    }
  ],
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 90
    },
    "strokeWidth": 3,
    "color": "#2F6F9F"
  },
  "encoding": {
    "x": {
      "field": "PeriodDate",
      "type": "temporal",
      "title": "Period"
    },
    "y": {
      "field": "Terabytes",
      "type": "quantitative",
      "title": "Terabytes downloaded",
      "axis": {
        "format": "~s"
      },
      "scale": {
        "domainMin": 0
      }
    },
    "tooltip": [
      {
        "field": "Period"
      },
      {
        "field": "Terabytes",
        "type": "quantitative",
        "format": ",",
        "title": "Terabytes"
      }
    ]
  }
}